# Copy this file to .env and fill in the Twilio values.
# SMS remains disabled unless this is changed to 1.
ECHINUS_SMS_ENABLED=0
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBER=+15557654321

# Optional local database override.
# ECHINUS_DB=./echinus.db